<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     HomeScreen — Focused-poster-as-background layout.
     The currently highlighted film's poster fills the entire screen;
     overlays keep branding and hero text readable.
     ======================================================================= -->
<component name="HomeScreen" extends="Group" initialFocus="rowList">

    <interface>
        <field id="content"      type="node" onChange="onContentChanged" />
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="screenActive" type="boolean" value="false" alwaysNotify="true" onChange="onScreenActiveChanged" />
    </interface>

    <children>
        <!-- Full-bleed focused-poster background (uri set dynamically) -->
        <Poster id="bgPoster"
            width="1920" height="1080"
            loadDisplayMode="scaleToZoom" />

        <!-- Dark purple vignette so text is always legible -->
        <Rectangle width="1920" height="1080" color="0x0A001E8C" />
        <!-- Neon bottom panel: hot-pink glow line, dark purple fade, neon grid (pre-rendered) -->
        <Poster uri="pkg:/images/neon_panel.png" width="1920" height="610" translation="[0, 470]" />

        <!-- Channel branding top-left: glowing pink title + green byline (pre-rendered glow) -->
        <Poster id="channelTitle" uri="pkg:/images/neon_title.png"
            width="1018" height="169" translation="[60, -10]" />
        <Poster id="bylineLabel" uri="pkg:/images/neon_byline.png"
            width="397" height="92" translation="[78, 86]" />

        <!-- Hero info mid-screen -->
        <!-- Fake neon glow: four faint cyan copies behind the hero title -->
        <Label id="heroGlow0"
            font="font:LargeBoldSystemFont"
            color="0x00F0FF55"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[97, 200]" />
        <Label id="heroGlow1"
            font="font:LargeBoldSystemFont"
            color="0x00F0FF55"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[103, 200]" />
        <Label id="heroGlow2"
            font="font:LargeBoldSystemFont"
            color="0x00F0FF55"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[100, 197]" />
        <Label id="heroGlow3"
            font="font:LargeBoldSystemFont"
            color="0x00F0FF55"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[100, 203]" />
        <Label id="heroTitle"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[100, 200]" />
        <Label id="heroMeta"
            font="font:SmallBoldSystemFont"
            color="0xFFE600FF"
            width="1200" height="34"
            translation="[102, 310]" />
        <Label id="heroDesc"
            font="font:MediumSystemFont"
            color="0xE0E0E0FF"
            maxLines="3" wrap="true"
            width="1400" height="110"
            translation="[102, 356]" />

        <!-- Category rows -->
        <!-- vertFocusAnimationStyle MUST stay fixedFocus or scrolling breaks -->
        <RowList id="rowList"
            translation="[100, 490]"
            itemSize="[1720, 412]"
            rowItemSize="[[240, 360]]"
            numRows="2"
            itemSpacing="[0, 20]"
            rowItemSpacing="[[30, 0]]"
            showRowLabel="true"
            rowLabelOffset="[[0, 4]]"
            rowLabelFont="font:MediumBoldSystemFont"
            rowLabelColor="0x39FF14FF"
            drawFocusFeedback="false"
            rowFocusAnimationStyle="fixedFocusWrap"
            vertFocusAnimationStyle="fixedFocus"
            itemComponentName="PosterItem" />
    </children>

    <script type="text/brightscript" uri="HomeScreen.brs" />
</component>
