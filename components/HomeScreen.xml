<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     HomeScreen — Focused-poster-as-background layout.
     The currently highlighted film's poster fills the entire screen;
     overlays keep branding and hero text readable.
     ======================================================================= -->
<component name="HomeScreen" extends="Group" initialFocus="rowList">

    <interface>
        <field id="content"      type="node" onChange="onContentChanged" />
        <field id="itemSelected" type="node" alwaysNotify="true" />
        <field id="screenActive" type="boolean" value="false" alwaysNotify="true" onChange="onScreenActiveChanged" />
    </interface>

    <children>
        <!-- Full-bleed focused-poster background (uri set dynamically) -->
        <Poster id="bgPoster"
            width="1920" height="1080"
            loadDisplayMode="scaleToZoom" />

        <!-- Dark vignette so text is always legible -->
        <Rectangle width="1920" height="1080" color="0x00000099" />
        <!-- Heavier bottom third where rows sit -->
        <Rectangle width="1920" height="500" translation="[0, 580]" color="0x000000BB" />

        <!-- Channel branding top-left -->
        <Label id="channelTitle"
            text="CLASSIC HORROR MOVIES"
            font="font:LargeBoldSystemFont"
            color="0xFF1E3EFF"
            horizAlign="left"
            width="1150" height="58"
            translation="[100, 30]" />
        <Label id="bylineLabel"
            text="by ParkerDataLink.com"
            font="font:MediumSystemFont"
            color="0xE8E8E8FF"
            horizAlign="left"
            width="700" height="38"
            translation="[102, 78]" />

        <!-- Hero info mid-screen -->
        <Label id="heroTitle"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            maxLines="2" wrap="true"
            width="1600" height="96"
            translation="[100, 200]" />
        <Label id="heroMeta"
            font="font:SmallBoldSystemFont"
            color="0xFF2E9DFF"
            width="1200" height="34"
            translation="[102, 310]" />
        <Label id="heroDesc"
            font="font:MediumSystemFont"
            color="0xE0E0E0FF"
            maxLines="3" wrap="true"
            width="1400" height="110"
            translation="[102, 356]" />

        <!-- Category rows -->
        <!-- vertFocusAnimationStyle MUST stay fixedFocus or scrolling breaks -->
        <RowList id="rowList"
            translation="[100, 520]"
            itemSize="[1700, 338]"
            rowItemSize="[[200, 300]]"
            numRows="2"
            itemSpacing="[0, 20]"
            rowItemSpacing="[[22, 0]]"
            showRowLabel="true"
            rowLabelOffset="[[0, 4]]"
            rowLabelFont="font:MediumBoldSystemFont"
            rowLabelColor="0xFFFFFFFF"
            drawFocusFeedback="false"
            rowFocusAnimationStyle="fixedFocusWrap"
            vertFocusAnimationStyle="fixedFocus"
            itemComponentName="PosterItem" />
    </children>

    <script type="text/brightscript" uri="HomeScreen.brs" />
</component>
