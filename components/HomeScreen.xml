<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     HomeScreen — Netflix-style browse screen.
     Atmospheric backdrop + a spotlight "hero" panel that reflects the
     currently focused title, above horizontal category rows of poster cards.
     ======================================================================= -->
<component name="HomeScreen" extends="Group" initialFocus="rowList">

    <interface>
        <field id="content"      type="node" onChange="onContentChanged" />
        <field id="itemSelected" type="node" alwaysNotify="true" />
    </interface>

    <children>
        <!-- Full-bleed atmospheric backdrop -->
        <Poster id="bgPoster"
            uri="pkg:/images/home_bg.jpg"
            width="1920" height="1080"
            loadDisplayMode="scaleToZoom" />

        <!-- Legibility scrim (darker toward the bottom where the rows sit) -->
        <Rectangle width="1920" height="1080" color="0x0A0A0A26" />
        <Rectangle width="1920" height="620" translation="[0, 460]" color="0x0A0A0ACC" />

        <!-- ── Branding ─────────────────────────────────────────────────── -->
        <Label id="channelTitle"
            text="CLASSIC HORROR MOVIES"
            font="font:LargeBoldSystemFont"
            color="0xE50914FF"
            horizAlign="left"
            width="1200" height="64"
            translation="[90, 48]" />
        <Label id="bylineLabel"
            text="by ParkerDataLink.com"
            font="font:MediumSystemFont"
            color="0xBFBFBFFF"
            horizAlign="left"
            width="800" height="40"
            translation="[92, 116]" />
        <Rectangle width="360" height="3" color="0x8B0000FF" translation="[92, 160]" />

        <!-- ── Spotlight hero (reflects the focused item) ──────────────────── -->
        <Poster id="heroPoster"
            width="300" height="450"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/poster_fallback.jpg"
            translation="[1500, 150]" />

        <Label id="heroTitle"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            maxLines="2" wrap="true"
            width="1120" height="120"
            translation="[90, 210]" />
        <Label id="heroMeta"
            font="font:SmallBoldSystemFont"
            color="0xE50914FF"
            width="1000" height="36"
            translation="[92, 330]" />
        <Label id="heroDesc"
            font="font:MediumSystemFont"
            color="0xD6D6D6FF"
            maxLines="3" wrap="true"
            width="1080" height="120"
            translation="[92, 372]" />
        <Label id="heroHint"
            text="OK  ▶ Play      ◀ ▶ ▲ ▼  Browse"
            font="font:SmallSystemFont"
            color="0x9A9A9AFF"
            width="1000" height="34"
            translation="[92, 500]" />

        <!-- ── Category rows ───────────────────────────────────────────────── -->
        <RowList id="rowList"
            translation="[90, 566]"
            itemSize="[1740, 344]"
            rowItemSize="[[200, 300]]"
            numRows="2"
            itemSpacing="[0, 40]"
            rowItemSpacing="[[22, 0]]"
            showRowLabel="true"
            rowLabelOffset="[[0, 6]]"
            rowLabelFont="font:MediumBoldSystemFont"
            rowLabelColor="0xF2F2F2FF"
            drawFocusFeedback="false"
            rowFocusAnimationStyle="fixedFocusWrap"
            vertFocusAnimationStyle="floatingFocus"
            itemComponentName="PosterItem" />
    </children>

    <script type="text/brightscript" uri="HomeScreen.brs" />
</component>
