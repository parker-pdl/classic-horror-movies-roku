<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     SplashScreen — branded welcome with an atmospheric backdrop and an
     animated reveal. Auto-advances after ~3.5 s or on OK / Back.
     ======================================================================= -->
<component name="SplashScreen" extends="Group">

    <interface>
        <field id="splashComplete" type="boolean" value="false" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="bgRect" width="1920" height="1080" color="0x000000FF" />

        <!-- Atmospheric backdrop, fades in -->
        <Poster id="openingImage"
            uri="pkg:/images/splash_fhd.jpg"
            width="1920" height="1080"
            loadDisplayMode="scaleToZoom"
            opacity="0.0" />

        <!-- Light scrim only; the artwork carries its own branding -->
        <Rectangle width="1920" height="1080" color="0x00000033" />

        <!-- Title -->
        <Label id="welcomeLabel"
            text="CLASSIC HORROR MOVIES"
            font="font:LargeBoldSystemFont"
            color="0xE50914FF"
            horizAlign="center" vertAlign="center"
            width="1920" height="90"
            translation="[0, 880]"
            opacity="0.0" />

        <!-- Byline -->
        <Label id="bylineLabel"
            text="by ParkerDataLink.com"
            font="font:MediumSystemFont"
            color="0xCFCFCFFF"
            horizAlign="center" vertAlign="center"
            width="1920" height="44"
            translation="[0, 990]"
            opacity="0.0" />

        <!-- Red glow accent line under the title -->
        <Rectangle id="glowLine"
            width="0" height="3"
            color="0xE50914FF"
            translation="[960, 962]" />

        <!-- Animations -->
        <Animation id="imageReveal" duration="1.4" repeat="false" easeFunction="inOutCubic">
            <FloatFieldInterpolator fieldToInterp="openingImage.opacity" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" />
        </Animation>

        <Animation id="textFadeIn" duration="1.2" repeat="false" delay="0.6" easeFunction="inOutCubic">
            <FloatFieldInterpolator fieldToInterp="welcomeLabel.opacity" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" />
            <FloatFieldInterpolator fieldToInterp="bylineLabel.opacity"  key="[0.0, 1.0]" keyValue="[0.0, 1.0]" />
        </Animation>

        <Animation id="glowExpand" duration="1.4" repeat="false" delay="0.9" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator fieldToInterp="glowLine.translation" key="[0.0, 1.0]" keyValue="[[960, 962], [560, 962]]" />
            <FloatFieldInterpolator fieldToInterp="glowLine.width" key="[0.0, 1.0]" keyValue="[0.0, 800.0]" />
        </Animation>

        <Timer id="splashTimer" duration="2.4" repeat="false" />
    </children>

    <script type="text/brightscript" uri="SplashScreen.brs" />
</component>
