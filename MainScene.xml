<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     MainScene — root SceneGraph scene.
     Orchestrates screen transitions: SplashScreen -> HomeScreen -> DetailScreen
     and kicks off the remote content feed load via a ContentLoader Task.
     ======================================================================= -->
<component name="MainScene" extends="Scene" initialFocus="splashScreen">

    <interface>
        <!-- alwaysNotify so a repeat deep link to the SAME contentId (e.g. a
             second roInputEvent while the channel is already running) still
             re-triggers navigation instead of being ignored as a no-op
             field write. -->
        <field id="deepLinkContentId" type="string" alwaysNotify="true" onChange="onDeepLinkChanged" />
        <field id="deepLinkMediaType" type="string" />
    </interface>

    <children>
        <SplashScreen  id="splashScreen"  visible="true"  />
        <HomeScreen    id="homeScreen"    visible="false" />
        <DetailScreen  id="detailScreen"  visible="false" />
    </children>

    <script type="text/brightscript" uri="MainScene.brs" />
</component>
