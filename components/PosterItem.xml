<?xml version="1.0" encoding="utf-8" ?>
<!-- =======================================================================
     PosterItem — portrait poster card used by the HomeScreen RowList.
     Fills a 2:3 poster, scales up on focus with a neon cyan/pink glow, and
     reveals the title beneath only when focused (Netflix-style).
     ======================================================================= -->
<component name="PosterItem" extends="Group">

    <interface>
        <field id="itemContent"  type="node"  onChange="onItemContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
    </interface>

    <children>
        <!-- Neon focus glow: cyan ring + hot-pink halo (pre-rendered), shown on focus -->
        <Poster id="focusGlow" uri="pkg:/images/neon_focus.png"
            width="340" height="460" translation="[-50, -50]" opacity="0.0" />
        <!-- Thin hot-pink outline on every poster (fades out when focused) -->
        <Poster id="focusBorder" uri="pkg:/images/neon_frame.png"
            width="244" height="364" translation="[-2, -2]" opacity="1.0" />

        <!-- Card backing -->
        <Rectangle id="cardBg" width="240" height="360" color="0x140D22FF" />

        <!-- Poster art (fills the card) -->
        <Poster id="posterImage"
            width="240" height="360"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/poster_fallback.jpg"
            loadingBitmapUri="pkg:/images/poster_fallback.jpg" />

        <!-- Bottom gradient + title strip shown on focus -->
        <Poster id="titleScrim" uri="pkg:/images/neon_scrim.png" width="240" height="100" translation="[0, 260]" opacity="0.0" />
        <Label id="titleLabel"
            font="font:SmallBoldSystemFont"
            color="0xFFFFFFFF"
            maxLines="2" wrap="true"
            horizAlign="center"
            width="232" height="76"
            translation="[4, 282]"
            opacity="0.0" />
    </children>

    <script type="text/brightscript" uri="PosterItem.brs" />
</component>
